{
  "name": "hanging-piece-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "build-n-start": "$npm_execpath run build && $npm_execpath run start",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "auth-db-generate": "$npm_execpath run build && npx @better-auth/cli@latest generate --config ./dist/config/auth.js",
    "pm2-start": "mkdir -p logs && $npm_execpath run build && pm2 start ecosystem.config.cjs",
    "pm2-restart": "$npm_execpath run build && pm2 restart ecosystem.config.cjs",
    "pm2-stop": "pm2 stop ecosystem.config.cjs",
    "pm2-logs": "pm2 logs hanging-piece-backend --lines 50",
    "auth-migrate-db": "$npm_execpath run build && npx @better-auth/cli migrate --config dist/config/auth.js"
  },
  "imports": {
    "#src/*": "./dist/*.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.0-beta.69",
    "@types/cors": "^2.8.19",
    "ai": "6.0.0-beta.145",
    "better-auth": "^1.4.3",
    "better-sqlite3": "^12.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "zod": "^4.1.13"
  }
}
