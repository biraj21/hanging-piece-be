{
  "name": "hanging-piece-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "build-n-start": "$npm_execpath run build && $npm_execpath run start",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "auth-db-generate": "$npm_execpath run build && npx @better-auth/cli@latest generate --config ./dist/config/auth.js",
    "pm2-start": "mkdir -p logs && $npm_execpath run build && pm2 start ecosystem.config.cjs",
    "pm2-restart": "$npm_execpath run build && pm2 restart ecosystem.config.cjs",
    "pm2-stop": "pm2 stop ecosystem.config.cjs",
    "pm2-logs": "pm2 logs hanging-piece-backend --lines 50",
    "auth-migrate-db": "$npm_execpath run build && npx @better-auth/cli migrate --config dist/config/auth.js"
  },
  "imports": {
    "#src/*": "./dist/*.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^7.0.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.69",
    "ai": "7.0.99",
    "better-auth": "^1.7.4",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "nodemailer": "^10.0.9",
    "zod": "^4.6.5"
  }
}
